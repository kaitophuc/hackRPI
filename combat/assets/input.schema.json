{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FG-CONTRACT-1-PROPOSED input snapshot",
  "type": "object",
  "required": ["version", "session", "sequence", "sender_ms", "pitch", "roll", "yaw", "throttle", "buttons", "focused", "connected"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "session": {"type": "string", "minLength": 1, "maxLength": 64},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "sender_ms": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "pitch": {"type": "number", "minimum": -1, "maximum": 1},
    "roll": {"type": "number", "minimum": -1, "maximum": 1},
    "yaw": {"type": "number", "minimum": -1, "maximum": 1},
    "vertical": {"type": "number", "minimum": -1, "maximum": 1, "default": 0},
    "throttle": {"type": "number", "minimum": 0, "maximum": 1},
    "buttons": {"type": "integer", "minimum": 0, "maximum": 15},
    "focused": {"type": "boolean"},
    "connected": {"type": "boolean"}
  }
}
