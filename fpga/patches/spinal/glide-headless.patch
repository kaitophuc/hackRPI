+#ifdef DE10_HEADLESS
+    /* The headless resolution is a real render-target layout, not just API
+     * bookkeeping. Round each RGB565 surface to the core's 4 KiB units.
+     */
+    {
+        FxU32 tiles = (sst1CurrentBoard->fbiVideoWidth + 63u) / 64u;
+        FxU32 surfaceBytes = tiles * 64u * sst1CurrentBoard->fbiVideoHeight * 2u;
+        FxU32 bufferOffset = (surfaceBytes + 4095u) / 4096u;
+        ISET(sst->fbiInit1, (IGET(sst->fbiInit1) & ~SST_VIDEO_TILES_IN_X) |
+             (tiles << SST_VIDEO_TILES_IN_X_SHIFT));
+        ISET(sst->fbiInit2, (IGET(sst->fbiInit2) & ~SST_VIDEO_BUFFER_OFFSET) |
+             (bufferOffset << SST_VIDEO_BUFFER_OFFSET_SHIFT));
+    }
+#endif
+
